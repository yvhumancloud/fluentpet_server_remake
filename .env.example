DATABASE_URL=postgresql+asyncpg://fluentpet:fluentpet@localhost:5432/fluentpet
DEVICE_API_KEY=change-me
JOB_API_KEY=change-me-too
ENV=dev
FIREBASE_CREDENTIALS_JSON=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
SENTRY_DSN=
# AI (PRD §12): no key and no token = /ai/* answer 503. AI_MODEL defaults to claude-opus-5.
ANTHROPIC_API_KEY=
# Any Messages-API-compatible gateway instead of Anthropic, e.g. Token Harbor:
#   ANTHROPIC_BASE_URL=https://tokenharbor.ai  ANTHROPIC_AUTH_TOKEN=thk_live_…  AI_MODEL=deepseek-v4.1-flash
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
AI_MODEL=
# per-request timeout; 30 is right for Anthropic, free gateway lanes need 120+
AI_TIMEOUT_SECONDS=30
# dev only (refused when ENV=prod): "Bearer ann" etc. stand in for Firebase tokens
DEV_TOKENS=ann:ann@example.com:Ann,bob:bob@example.com:Bob,dan:dan@example.com:Dan
